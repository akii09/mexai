{
  "name": "mexai",
  "version": "0.1.0",
  "description": "Local-first AI context manager for developers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mexai/mexai.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mexai": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mexai/core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@mexai/tsconfig": "workspace:*",
    "@mexai/eslint-config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "ai",
    "context",
    "mcp",
    "developer-tools",
    "cli",
    "cursor",
    "claude"
  ]
}